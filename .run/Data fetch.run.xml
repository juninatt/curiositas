<!-- Writes the persons of every theme in data/themes from Wikidata to data/persons, for review with git diff before the import. Same as data.cmd fetch; Docker must be running. -->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Data: fetch" type="Application" factoryName="Application" folderName="Data">
    <option name="MAIN_CLASS_NAME" value="se.pbt.curiositas.CuriositasApplication" />
    <module name="curiositas" />
    <!-- Keeps IntelliJ from attaching to a process that ends within a second, which only logs an error -->
    <option name="VM_PARAMETERS" value="-XX:+DisableAttachMechanism" />
    <option name="PROGRAM_PARAMETERS" value="--spring.profiles.active=data-command --curiositas.data.command=fetch" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
